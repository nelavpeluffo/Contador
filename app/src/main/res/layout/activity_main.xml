<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===================== MITAD SUPERIOR ===================== -->
    <FrameLayout
        android:id="@+id/topHalf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/top_bg">

        <!-- Durante la rutina: tiempo total -->
        <LinearLayout
            android:id="@+id/topRunning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/SmallCaption"
                android:text="TIEMPO TOTAL"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="120sp"
                android:autoSizeMinTextSize="36sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="1"
                android:text="00:00"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/totalPlay"
                    style="@style/IconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Iniciar o pausar"
                    android:src="@drawable/ic_play" />

                <ImageView
                    android:id="@+id/totalStop"
                    style="@style/IconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Finalizar"
                    android:src="@drawable/ic_stop" />
            </LinearLayout>
        </LinearLayout>

        <!-- Al finalizar: resumen -->
        <LinearLayout
            android:id="@+id/topSummary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <TextView
                style="@style/SmallCaption"
                android:text="RUTINA FINALIZADA"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/card_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/SmallCaption"
                        android:text="TOTAL"
                        android:textColor="#60A5FA" />

                    <TextView
                        android:id="@+id/summaryTotal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:autoSizeMaxTextSize="40sp"
                        android:autoSizeMinTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-light"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="00:00"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/card_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/SmallCaption"
                        android:text="INTERVALO"
                        android:textColor="#2DD4BF" />

                    <TextView
                        android:id="@+id/summaryInterval"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:autoSizeMaxTextSize="40sp"
                        android:autoSizeMinTextSize="18sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-light"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="30"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiempo total"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detailTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rondas"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/detailRounds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Historial"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#000000" />

    <!-- ===================== MITAD INFERIOR ===================== -->
    <LinearLayout
        android:id="@+id/bottomHalf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exerciseLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.15"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/roundLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/intervalTime"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="180sp"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:text="30" />

        <ProgressBar
            android:id="@+id/intervalProgress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginBottom="12dp"
            android:max="1000"
            android:progress="1000" />

        <!-- Configuración (visible antes de empezar y al finalizar) -->
        <LinearLayout
            android:id="@+id/configBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/captionA"
                        style="@style/SmallCaption"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:text="TIEMPO 1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/minusA"
                            style="@style/PillButton"
                            android:layout_width="40dp"
                            android:contentDescription="Un minuto menos"
                            android:text="−"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/valueA"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="1 min"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/plusA"
                            style="@style/PillButton"
                            android:layout_width="40dp"
                            android:contentDescription="Un minuto más"
                            android:text="+"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/captionB"
                        style="@style/SmallCaption"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:text="TIEMPO 2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/minusB"
                            style="@style/PillButton"
                            android:layout_width="40dp"
                            android:contentDescription="Un minuto menos"
                            android:text="−"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/valueB"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="1 min"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/plusB"
                            style="@style/PillButton"
                            android:layout_width="40dp"
                            android:contentDescription="Un minuto más"
                            android:text="+"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exerciseRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/captionExercises"
                    style="@style/SmallCaption"
                    android:layout_width="84dp"
                    android:text="EJERCICIOS" />
                <!-- Los círculos 1–5 se agregan desde el código -->
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/intervalPlay"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:contentDescription="Iniciar o pausar"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/intervalStop"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Finalizar"
                android:src="@drawable/ic_stop" />

            <ImageView
                android:id="@+id/intervalReset"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:contentDescription="Reiniciar bloque"
                android:src="@drawable/ic_replay" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- ===================== HISTORIAL (panel lateral) ===================== -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#B3000000"
        android:clickable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/top_bg"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Historial"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/drawerClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
